# Task Orchestrator v2 环境配置

# LLM
PTA_LLM_PROVIDER=openai
PTA_LLM_MODEL=deepseek-chat
PTA_LLM_BASE_URL=https://api.deepseek.com
PTA_LLM_API_KEY=

# 使用 Fake 模型（无需 key，确定性输出）
# PTA_LLM_PROVIDER=fake

# A2A 远端 Agent(仅组长 role=leader 时使用,指向组员 PT 的 A2A 地址)
PTA_A2A_AGENTS=[]

# 远端 REST 垂类 Agent(如检索):JSON 数组,每个含 name/base_url/api_key/capability
# capability 默认 retrieve;认证头用 Authorization: Bearer <api_key>
# PTA_EXTERNAL_AGENTS=[{"name":"retrieval-web","base_url":"https://retrieval.example.com","api_key":"","capability":"retrieve"}]

# 角色:leader(组长,可下发任务+读组员报告) / member(组员,只被下发+发报告)
# 组长实例配 leader;组员实例配 member(且不设 PTA_A2A_AGENTS)
PTA_A2A_ROLE=member

# 组员作为 A2A 服务端监听的端口(组长通过它下发)
PTA_A2A_PORT=8101

# Codex（需要 pip install openai-codex）
PTA_CODEX_ENABLED=false
PTA_CODEX_SANDBOX=workspace_write
PTA_CODEX_MODEL=gpt-5.4

# 本机 codex CLI 适配器(注册现成 coding agent,包装 codex exec,capability=code)
# 需要本机已安装 codex CLI 且已登录;开启后 build_registry 注册 codex_cli
PTA_CODEX_CLI_ENABLED=false
# 可留空(自动发现 native codex.exe);显式指定时用绝对路径
PTA_CODEX_CLI_CMD=
PTA_CODEX_CLI_WORKDIR=./data/codex-workspace
# codex 主目录(配置/认证/sandbox 组件)。Windows 多 codex 安装时必须显式指定,
# 否则用错账号或找不到组件导致弹"找不到文件"。如 D:\software\codex-cli\codex-cli-data
PTA_CODEX_CLI_HOME=
# codex 审批模式: ask(强提醒人工介入) / auto(自动执行) / full(完全绕过)
PTA_CODEX_APPROVAL_MODE=auto

# 本地工具
PTA_LOCAL_TOOLS=shell,file,web

# 邮箱(可选,组员发报告 / 组长读报告用)
# PTA_SMTP_HOST=smtp.qq.com
# PTA_SMTP_PORT=587
# PTA_SMTP_USER=xxx@qq.com
# PTA_SMTP_PASSWORD=授权码
# PTA_EMAIL_FROM=xxx@qq.com
# PTA_IMAP_HOST=imap.qq.com
# PTA_IMAP_PORT=993

# 服务端口
PTA_API_PORT=8000
PTA_BIND_HOST=127.0.0.1

# 日志
PTA_LOG_LEVEL=INFO
PTA_LOG_FORMAT=console

# 数据目录
PTA_DATA_DIR=./data
